# Anthropic API key used by the orchestrator service
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# --- Postgres ---
# From the host machine (psql, orchestrator running outside Docker): localhost.
# From inside the Compose network (e.g. the keycloak service): the service name "postgres".
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Container bootstrap superuser. Used only by the init script to create the
# two application databases/users below; app services never use this role.
POSTGRES_SUPERUSER=CHANGE_ME_superuser
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_superuser_password
# Keycloak's own database (separate DB + user from the app database)
POSTGRES_KEYCLOAK_DB=keycloak
POSTGRES_KEYCLOAK_USER=CHANGE_ME_keycloak_db_user
POSTGRES_KEYCLOAK_PASSWORD=CHANGE_ME_keycloak_db_password
# Travel app database (module 2+, includes the pgvector extension)
POSTGRES_TRAVEL_DB=travel
POSTGRES_TRAVEL_USER=CHANGE_ME_travel_db_user
POSTGRES_TRAVEL_PASSWORD=CHANGE_ME_travel_db_password
#
# IMPORTANT: docker-entrypoint-initdb.d only runs when the Postgres data
# volume is empty (first boot). If you change any POSTGRES_* password above
# after the first `tools/dev.py up`, the running database keeps the old
# value -- editing .env does not change it. Run `tools/dev.py reset` (which
# deletes local data and reinitializes) to apply new credentials.

# --- Keycloak ---
# Two separate realms, defined as code in infra/keycloak/realms/ (see
# docs/decisions/0004-identity-two-realms.md). None of the values below are
# secrets: realm and client IDs are public by design (they're in the
# versioned realm JSON too), so they're real dev defaults, not CHANGE_ME
# placeholders.
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_CUSTOMERS_REALM=travel-customers
KEYCLOAK_CUSTOMERS_PUBLIC_CLIENT=web-public
KEYCLOAK_CUSTOMERS_API_CLIENT=orchestrator-api
KEYCLOAK_ADMIN_REALM=travel-admin
KEYCLOAK_ADMIN_PUBLIC_CLIENT=back-office
KEYCLOAK_ADMIN_API_CLIENT=admin-api
# Local admin console bootstrap (local/dev infra only). KC_BOOTSTRAP_ADMIN_*
# replaces the deprecated KEYCLOAK_ADMIN/KEYCLOAK_ADMIN_PASSWORD in 26.x.
# This is a real secret and never goes in the realm JSON.
KC_BOOTSTRAP_ADMIN_USERNAME=CHANGE_ME_admin_username
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_admin_password

# --- RabbitMQ (profile: messaging, off by default) ---
RABBITMQ_USER=CHANGE_ME_rabbitmq_user
RABBITMQ_PASSWORD=CHANGE_ME_rabbitmq_password

# --- SQL Server (profile: mssql, off by default) ---
MSSQL_SA_PASSWORD=CHANGE_ME_sa_password
# Must literally be "Y" to accept the SQL Server EULA; not a secret.
MSSQL_ACCEPT_EULA=Y
# Caps SQL Server's own buffer pool. The container's memory limit is 3g
# (see infra/compose/docker-compose.yml) because SQL Server needs ~2GB just
# to start -- a container limit of exactly 2g kills it on boot. This value
# bounds the engine's usage inside that 3g headroom.
MSSQL_MEMORY_LIMIT_MB=2048
