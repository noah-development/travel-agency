# Anthropic API key used by the orchestrator service
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Postgres database name
POSTGRES_DB=CHANGE_ME_db_name
# Postgres user
POSTGRES_USER=CHANGE_ME_user
# Postgres password
POSTGRES_PASSWORD=CHANGE_ME_password
# Postgres host as reachable from apps (service name in compose)
POSTGRES_HOST=CHANGE_ME_host
# Postgres port
POSTGRES_PORT=5432

# Keycloak realm used by the apps
KEYCLOAK_REALM=CHANGE_ME_realm
# Keycloak base URL (issuer)
KEYCLOAK_URL=https://CHANGE_ME.example.invalid
# Keycloak client id
KEYCLOAK_CLIENT_ID=CHANGE_ME_client_id
# Keycloak client secret
KEYCLOAK_CLIENT_SECRET=CHANGE_ME_client_secret
# Keycloak admin bootstrap password (local/dev infra only)
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_admin_password
