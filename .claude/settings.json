{
  "permissions": {
    "allow": [
      "Bash(uv sync*)",
      "Bash(uv run*)",
      "Bash(uv lock*)",
      "Bash(pnpm install*)",
      "Bash(pnpm run*)",
      "Bash(pnpm exec*)",
      "Bash(pytest*)",
      "Bash(ruff*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git restore*)",
      "Bash(git fetch*)",
      "Bash(git pull*)"
    ],
    "ask": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git branch -D*)",
      "Bash(docker*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "python",
              "-c",
              "import json, sys, subprocess\nd = json.load(sys.stdin)\npath = d.get('tool_input', {}).get('file_path')\nif not path:\n    sys.exit(0)\nsys.exit(subprocess.run(['uv', 'run', 'python', 'tools/check_portability.py', '--json', path]).returncode)"
            ],
            "timeout": 30,
            "statusMessage": "Checking cloud portability"
          }
        ]
      }
    ]
  }
}
